from collections import Counter, defaultdict
from nltk.tokenize import word_tokenize

# Note: If you haven't downloaded the tokenizer punkt package yet, run:
# import nltk
# nltk.download('punkt')
# nltk.download('punkt_tab')

# Corpus text
text = (
    "I love natural language processing. I love machine learning. I study"
    " natural language processing. I study machine learning."
)

print("--- 1. Tokenization ---")
# 1. Tokenize the text using word_tokenize and filter out punctuation
raw_tokens = word_tokenize(text)
tokens = [t for t in raw_tokens if t.isalnum()]
print(f"Tokens ({len(tokens)} total): {tokens}\n")

print("--- 2 & 3. Create and Count Trigrams ---")
# 2. Create trigrams (tuples of 3 consecutive words)
trigrams = []
for i in range(len(tokens) - 2):
  trigram = (tokens[i], tokens[i + 1], tokens[i + 2])
  trigrams.append(trigram)

# 3. Count trigrams and bigram contexts
trigram_counts = Counter(trigrams)
print("Trigram Counts:")
for tg, count in trigram_counts.items():
  print(f"  {tg}: {count}")
print()

print("--- 4. Calculate Trigram Probabilities ---")
# Build a conditional probability model: P(w3 | w1, w2) = C(w1, w2, w3) / C(w1, w2)
model = defaultdict(Counter)
for w1, w2, w3 in trigrams:
  model[(w1, w2)][w3] += 1

probabilities = {}
for context, next_word_counts in model.items():
  total_context_count = sum(next_word_counts.values())
  probabilities[context] = {
      word: count / total_context_count for word, count in next_word_counts.items()
  }

print("Trigram Probabilities calculated successfully.\n")

print("--- 5, 6 & 7. Prediction for current_words = ('I', 'love') ---")
# 5. Define the context
current_words = ("I", "love")

if current_words in probabilities:
  next_word_probs = probabilities[current_words]

  # 6. Display possible next words and their probabilities
  print(f"6. Possible next words after {current_words} and their probabilities:")
  for word, prob in next_word_probs.items():
    print(f"   - '{word}': {prob:.2f} ({prob * 100:.0f}%)")

  # 7. Display the most likely next word(s)
  max_prob = max(next_word_probs.values())
  most_likely_words = [
      word for word, prob in next_word_probs.items() if prob == max_prob
  ]
  print(
      f"\n7. Most likely next word(s): {most_likely_words} with a probability"
      f" of {max_prob:.2f}"
  )
else:
  print(f"Context {current_words} not found in the training corpus.")